{
  "name": "inventory-backend",
  "version": "1.0.0",
  "description": "Household inventory tracking system backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "vitest run && npm run test:client",
    "test:client": "npm --prefix client ci && npm --prefix client run test",
    "build:client": "npm --prefix client ci && npm --prefix client run build",
    "pretest:e2e": "npm run build:client",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fuse.js": "^7.5.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "playwright": "^1.64.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
